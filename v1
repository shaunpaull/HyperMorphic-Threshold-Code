def build_prime_table(n: int, e_levels: int) -> list:
    """
    Build PRIME_TABLE[i][e] = prime for shard i, entropy level e.

    Layout: shards separated by e_levels slots in the prime sequence.
    This guarantees:
      - All n × e_levels entries are distinct primes
      - For fixed entropy level e: PRIME_TABLE[i][e] are all distinct
      - product(PRIME_TABLE[i][0] for i in range(k)) > max possible chunk
    """
    total_needed = n * e_levels
    pool = primes_from(509, total_needed + 20)  # start at 509 for gaps > 256

    table = []
    for i in range(n):
        row = []
        for e in range(e_levels):
            row.append(pool[i * e_levels + e])
        table.append(row)
    return table

def verify_prime_table(table: list, n: int, e_levels: int, k: int, chunk_bytes: int):
    """Verify all correctness invariants of the prime table."""
    flat = [p for row in table for p in row]

    # All prime
    assert all(is_prime(p) for p in flat), "Non-prime in table"

    # All distinct
    assert len(set(flat)) == len(flat), "Duplicate primes"

    # For each entropy level, k smallest product > max_chunk
    for e in range(e_levels):
        level_primes = sorted(table[i][e] for i in range(n))
        prod_k = reduce(lambda a, b: a * b, level_primes[:k], 1)
        max_chunk = 256 ** chunk_bytes - 1
        assert prod_k > max_chunk, \
            f"Level {e}: prod_k={prod_k} <= max_chunk={max_chunk}"

    return True

