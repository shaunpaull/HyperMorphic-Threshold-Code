    print("╚══════════════════════════════════════════════════════════════════════╝")

    htc = HyperMorphicThresholdCode(n=10, k=6, W=8, E_levels=9)

    # ── 1. PRIME TABLE INVARIANTS ───────────────────────────────────────
    section("1. PRIME TABLE INVARIANTS")
    flat = [htc.prime_table[i][e] for i in range(htc.n) for e in range(htc.E_levels)]

    check("All primes in table are prime",
          all(is_prime(p) for p in flat))

    check("All primes distinct (no collisions)",
          len(set(flat)) == len(flat),
          f"{len(flat)} distinct")

    check("Pairwise coprime within each entropy level",
          all(math.gcd(htc.prime_table[i][e], htc.prime_table[j][e]) == 1
              for e in range(htc.E_levels)
              for i in range(htc.n) for j in range(i+1, htc.n)))

    for e in range(htc.E_levels):
        primes = sorted(htc.prime_table[i][e] for i in range(htc.n))
        prod_k  = reduce(lambda a,b: a*b, primes[:htc.k], 1)
        max_c   = 256**htc.chunk_bytes - 1
        check(f"Level {e}: prod(k primes) > max_chunk",
              prod_k > max_c,
              f"{prod_k:.2e} > {max_c:.2e}")

    check("All SafeGear bases coprime to their prime",
          all(math.gcd(htc._base_table[i][e], htc.prime_table[i][e]) == 1
              for i in range(htc.n) for e in range(htc.E_levels)))

    # ── 2. BASIC ROUNDTRIP ──────────────────────────────────────────────
    section("2. BASIC ROUNDTRIP — No Erasures")
    test_cases = [
        ("short string",    b"HyperMorphic HTC"),
        ("single byte",     b"x"),
        ("all zeros",       bytes(256)),
        ("all 0xFF",        bytes([255]*256)),
        ("full byte range", bytes(range(256))),
        ("random 512B",     os.urandom(512)),
        ("random 2KB",      os.urandom(2048)),
        ("long repeat",     b"ABCDEF" * 200),
    ]
    for name, data in test_cases:
        shards = htc.encode(data)
        recovered = htc.decode(shards)
        check(f"Roundtrip: {name:<35}", recovered == data,
              f"len={len(data)}")

    # ── 3. THRESHOLD PROPERTY ───────────────────────────────────────────
    section("3. THRESHOLD PROPERTY — k-of-n")
    msg = b"Threshold test data for HTC primitive"
    shards = htc.encode(msg)

    for n_erase in range(htc.n - htc.k + 2):
        erased = shards[:]
        for i in range(n_erase): erased[i] = None
        should_pass = (n_erase <= htc.n - htc.k)
        try:
            r = htc.decode(erased)
            outcome = (r == msg) == should_pass
        except ValueError:
            outcome = not should_pass
        check(f"Erase {n_erase:>2}/{htc.n} → {'recover' if should_pass else 'fail'}",
              outcome, f"({'ok' if outcome else 'WRONG'})")

    # ── 4. ALL C(n,k) SUBSET COMBINATIONS ──────────────────────────────
    section(f"4. ALL C({htc.n},{htc.k})=210 SUBSET COMBINATIONS")
    msg = b"Exhaustive subset test"
    shards = htc.encode(msg)
    combos = list(combinations(range(htc.n), htc.k))
    failed = []
    for combo in combos:
        subset = [shards[i] if i in combo else None for i in range(htc.n)]
        try:
            r = htc.decode(subset)
            if r != msg: failed.append(combo)
        except Exception as ex:
            failed.append((combo, str(ex)))
    check(f"All {len(combos)} C({htc.n},{htc.k}) subsets recover correctly",
          len(failed) == 0, f"{len(combos)-len(failed)}/{len(combos)}")

    # ── 5. ADAPTIVE PRIME TOPOLOGY ──────────────────────────────────────
    section("5. ADAPTIVE PRIME TOPOLOGY (the new property)")
    # Different entropy levels → different primes → different coding geometry
    low_ent  = bytes([42] * 256)               # H ≈ 0 bits/byte
    high_ent = bytes(range(256)) * 2           # H = 8 bits/byte

    primes_low_e0  = htc.prime_table[0][0]
    primes_high_e8 = htc.prime_table[0][htc.E_levels - 1]
    check("Prime at max entropy > prime at min entropy (shard 0)",
          primes_high_e8 > primes_low_e0,
          f"e=0: {primes_low_e0}  e={htc.E_levels-1}: {primes_high_e8}")

    # Verify products grow with entropy
    prods = []
    for e in range(htc.E_levels):
        primes = sorted(htc.prime_table[i][e] for i in range(htc.n))
        prods.append(reduce(lambda a,b: a*b, primes[:htc.k], 1))
    check("Product of k primes increases monotonically with entropy level",
          all(prods[e] <= prods[e+1] for e in range(htc.E_levels-1)),
          f"range: {prods[0]:.2e} → {prods[-1]:.2e}")

    cap_ratio = math.log(prods[-1], 256) / math.log(prods[0], 256)
    check("Effective capacity varies with entropy level (adaptive capacity)",
          cap_ratio > 1.0,
          f"{cap_ratio:.4f}× capacity range")

    # Recover correctly at both extremes
    for name, data in [("low entropy", low_ent), ("high entropy", high_ent)]:
        shards = htc.encode(data)
        for i in range(4): shards[i] = None  # erase 4 shards
        r = htc.decode(shards)
        check(f"Recovery at {name}", r == data, "with 4 erasures")

    # ── 6. CONTENT-ADDRESSED MIXING (λ) ─────────────────────────────────
    section("6. CONTENT-ADDRESSED MIXING TERM λ")
    # Zero data without λ would give r=0. With λ, each position is unique.
    zero_data = bytes(256)
    shards = htc.encode(zero_data)

    # Check that residues are NOT all zero (λ prevents zero-pattern leakage)
    shard0_residues = shards[0].residues
    all_zero = all(r == 0 for r in shard0_residues)
    check("Zero input produces non-zero residues (λ prevents leakage)",
          not all_zero,
          f"unique values in shard 0: {len(set(shard0_residues))}")

    # Check λ varies per position
    lambdas = [htc._lambda(0, pos, htc.prime_table[0][0]) for pos in range(20)]
    check("λ(i, pos) varies with position",
          len(set(lambdas)) > 10,
          f"{len(set(lambdas))}/20 unique λ values")

    # Verify 1-bit change propagates to all shards
    data1 = b"Hello HTC" * 50
    data2 = bytearray(data1); data2[0] ^= 1; data2 = bytes(data2)
    s1 = htc.encode(data1)
    s2 = htc.encode(data2)
    diffs = [sum(a != b for a, b in zip(s1[i].residues, s2[i].residues))
             for i in range(htc.n)]
    check("1-bit change propagates to ALL n shards (avalanche)",
          all(d > 0 for d in diffs),
          f"changes per shard: {diffs}")

    # ── 7. BYZANTINE FAULT DETECTION ────────────────────────────────────
    section("7. BYZANTINE FAULT DETECTION")
    msg = b"Byzantine tolerance test - HTC primitive"
    shards = htc.encode(msg)

    # Corrupt 1 shard (within t = floor((n-k)/2) = 2 correctable)
    shards_corrupt = shards[:]
    # Deep copy to avoid mutation
    import copy
    shards_corrupt = [copy.deepcopy(s) for s in shards]
    shards_corrupt[0].residues[0] ^= 1   # flip one residue bit

    data_byz, report = htc.decode_byzantine(shards_corrupt)
    check("Byzantine decode: recovers correct data with 1 corrupt shard",
          data_byz == msg, "")
    check("Byzantine report identifies bad shard",
          0 in report['bad_shards'],
          f"bad={report['bad_shards']} good={report['good_shards']}")

    # Corrupt 2 shards simultaneously
    import copy
    shards_c2 = [copy.deepcopy(s) for s in shards]
    shards_c2[1].residues[0] ^= 1
    shards_c2[3].residues[1] ^= 1
    data_c2, rep2 = htc.decode_byzantine(shards_c2)
    check("Byzantine decode: recovers with 2 corrupt shards",
          data_c2 == msg,
          f"bad_shards={rep2['bad_shards']}")

    # Shard HMAC detects tampering
    shards_tamper = [copy.deepcopy(s) for s in shards]
    shards_tamper[0].residues[0] ^= 0xFF
    shards_tamper[0].shard_hmac = b'\x00' * 32  # invalidate HMAC
    valid_after = htc._valid_shards(shards_tamper, require_hmac=True)
    check("Shard HMAC rejects tampered shard",
          0 not in [s.index for s in valid_after],
          f"{len(valid_after)}/{htc.n} shards pass HMAC")

    # ── 8. CAUSAL ENTROPY WINDOW ─────────────────────────────────────────
    section("8. CAUSAL ENTROPY WINDOW")
    # Encode half low-entropy, half high-entropy data
    mixed = bytes([42]*512) + bytes(range(256))*2
    shards = htc.encode(mixed)
    # Must decode perfectly (causal window reproduced exactly)
    r = htc.decode(shards)
    check("Mixed-entropy data (causal window required)", r == mixed,
          f"len={len(mixed)}")

    # Verify decoder reproduces encoder's entropy estimates exactly
    htc2 = HyperMorphicThresholdCode(n=10, k=6, W=8, E_levels=9)
    data = os.urandom(1024)
    shards = htc2.encode(data)
    for i in range(4): shards[i] = None
    check("Causal window: decode with 4 erasures, 1KB random",
          htc2.decode(shards) == data, "")

    # ── 9. COMPARISON: HTC vs STANDARD CRT CODE ─────────────────────────
    section("9. COMPARISON: HTC vs STANDARD CRT CODE")
    print()
    print(f"  {'Property':<40} {'Standard CRT':>16} {'HTC':>16}")
    print(f"  {'─'*40} {'─'*16} {'─'*16}")

    comparisons = [
        ("Threshold recovery (any k-of-n)",       "✓",       "✓"),
        ("MDS distance (n-k+1)",                   "✓",       "✓"),
        ("Fixed prime constellation",              "✓",       "✗ adaptive"),
        ("Adaptive prime topology",                "✗",       "✓ NEW"),
        ("Content-addressed mixing (λ)",           "✗",       "✓ NEW"),
        ("Zero-pattern protection",                "✗",       "✓ NEW"),
        ("Byzantine fault detection",              "✗",       "✓ NEW"),
        ("Variable effective capacity",            "✗",       "✓ NEW"),
        ("Entropy-correlated geometry",            "✗",       "✓ NEW"),
        ("Shard integrity (HMAC)",                 "✗",       "✓ NEW"),
        ("Parameters (n, k)",                      "(n,k)",   "(n,k,W,E)"),
    ]
    for prop, crt_val, htc_val in comparisons:
        print(f"  {prop:<40} {crt_val:>16} {htc_val:>16}")

    # ── 10. PERFORMANCE ──────────────────────────────────────────────────
    section("10. PERFORMANCE BENCHMARKS")
    for sz in [100, 1000, 10000, 50000]:
        data = os.urandom(sz)
        t0 = time.perf_counter()
        for _ in range(3): shards = htc.encode(data)
        t_enc = (time.perf_counter() - t0) / 3

        t0 = time.perf_counter()
        for _ in range(3): htc.decode(shards)
        t_dec = (time.perf_counter() - t0) / 3

        print(f"  {sz:>6} bytes:  enc {sz/t_enc/1024:>7.1f} KB/s  "
              f"dec {sz/t_dec/1024:>7.1f} KB/s  "
              f"({t_enc*1000:.1f}ms / {t_dec*1000:.1f}ms)")

    # ── SUMMARY ──────────────────────────────────────────────────────────
    n_pass = sum(results)
    print(f"\n{'═'*72}")
    print(f"  RESULTS: {n_pass}/{len(results)} passed")
    print(f"{'═'*72}")
    if n_pass == len(results):
        print("  ✅ ALL PASS — HTC primitive validated")
    else:
        print(f"  ❌ {len(results)-n_pass} FAILURES")
    return n_pass == len(results)


