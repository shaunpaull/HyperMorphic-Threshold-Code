# SECTION 3 — ENTROPY WINDOW (causal)
# ═══════════════════════════════════════════════════════════════════════

class CausalEntropyWindow:
    """
    Causal entropy estimator: only uses data from BEFORE current position.
    Critical for decodability — decoder reconstructs same entropy estimates
    from already-decoded chunks.
    """
    def __init__(self, window_size: int = 8, chunk_bytes: int = 7):
        self.W = window_size
        self.chunk_bytes = chunk_bytes
        self._buffer = []   # decoded chunks (ints)

    def push(self, chunk_int: int):
        """Add a decoded chunk to the window."""
        self._buffer.append(chunk_int)
        if len(self._buffer) > self.W:
            self._buffer.pop(0)

    def estimate(self) -> float:
        """Current entropy estimate (before processing current chunk)."""
        if not self._buffer:
            return 0.0
        data = b''.join(c.to_bytes(self.chunk_bytes, 'big') for c in self._buffer)
        return shannon_entropy(data)

    def reset(self):
        self._buffer = []

