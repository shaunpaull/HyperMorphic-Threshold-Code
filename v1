def _egcd(a: int, b: int):
    if a == 0: return b, 0, 1
    g, x, y = _egcd(b % a, a)
    return g, y - (b // a) * x, x

def modinv(a: int, m: int) -> int:
    g, x, _ = _egcd(a % m, m)
    if g != 1: raise ArithmeticError(f"No inverse: gcd({a},{m})={g}")
    return x % m

def crt(residues: list, moduli: list) -> int:
    """CRT reconstruction. Moduli must be pairwise coprime."""
    M = reduce(lambda a, b: a * b, moduli, 1)
    x = 0
    for r, m in zip(residues, moduli):
        Mi = M // m
        x += r * Mi * modinv(Mi % m, m)
    return x % M

def is_prime(n: int) -> bool:
    if n < 2: return False
    if n < 4: return True
    if n % 2 == 0 or n % 3 == 0: return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0: return False
        i += 6
    return True

def next_prime(n: int) -> int:
    while not is_prime(n): n += 1
    return n

def primes_from(start: int, count: int) -> list:
    result, n = [], start
    while len(result) < count:
        if is_prime(n): result.append(n)
        n += 1
    return result

def safe_base(m: int) -> int:
    """SafeGear: smallest b > 1 with gcd(b, m) = 1."""
    b = math.floor(math.log2(max(m, 2))) + 1
    while math.gcd(b, m) != 1: b += 1
    return b

def shannon_entropy(data: bytes) -> float:
    if not data: return 0.0
    counts = Counter(data)
    n = len(data)
    return -sum((c/n) * math.log2(c/n) for c in counts.values())

def shake128_int(seed: bytes, byte_len: int) -> int:
    """Deterministic int from SHAKE128."""
    h = hashlib.shake_128(seed)
    return int.from_bytes(h.digest(byte_len), 'big')

