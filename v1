@dataclass
class HTCShard:
    """
    One shard in a HyperMorphic Threshold Code encoding.
    Stores only residues + metadata; parameters are regenerated at decode.
    """
    index:      int
    residues:   list            # r_i(pos) for each chunk position
    data_len:   int             # original data length (for unpadding)
    data_hmac:  bytes           # HMAC-SHA256 of original data (integrity)
    shard_hmac: bytes           # HMAC-SHA256 of this shard's residues
    n:          int
    k:          int
    W:          int
    E_levels:   int
    chunk_bytes:int

    def compute_shard_hmac(self) -> bytes:
        payload = str(self.index).encode() + str(self.residues).encode()
        return hashlib.sha256(payload).digest()

    def verify_shard_hmac(self) -> bool:
        return self.shard_hmac == self.compute_shard_hmac()

    def __repr__(self):
        return (f"HTCShard(i={self.index}, n={self.n}, k={self.k}, "
                f"chunks={len(self.residues)}, valid={self.verify_shard_hmac()})")

# ═══════════════════════════════════════════════════════════════════════
# SECTION 5 — THE HTC CODEC
# ═══════════════════════════════════════════════════════════════════════

class HyperMorphicThresholdCode:
    """
    HyperMorphic Threshold Code (HTC): a data-adaptive erasure code primitive.

    Compared to standard CRT threshold codes (Asmuth-Bloom):
      + Adaptive prime topology per chunk (new)
      + Content-addressed mixing term λ (new)
      + Byzantine fault detection via majority vote (new)
      + Variable effective capacity tied to local entropy (new)
      = Same MDS distance (n-k+1), same threshold guarantee

    Parameters
    ----------
    n : int       Total shards produced
    k : int       Minimum shards for reconstruction (threshold)
    W : int       Entropy window width in chunks (adaptation speed)
    E_levels: int Entropy quantization levels (adaptation range)
    """

    def __init__(self, n: int = 10, k: int = 6,
                 W: int = 8, E_levels: int = 9):
        assert 2 <= k <= n
        self.n = n
        self.k = k
        self.W = W
        self.E_levels = E_levels

        # Build prime table
        self.prime_table = build_prime_table(n, E_levels)

        # Compute chunk_bytes from SMALLEST primes (entropy level 0)
        # Guarantees threshold holds even at minimum entropy
        level0_primes = sorted(self.prime_table[i][0] for i in range(n))
        prod_k_min = reduce(lambda a, b: a * b, level0_primes[:k], 1)
        self.chunk_bytes = max(1, int(math.log(prod_k_min, 256)))
        self.max_chunk   = 256 ** self.chunk_bytes - 1

        assert prod_k_min > self.max_chunk, "Prime table insufficient for chunk size"

        # Precompute safe bases for every prime in table
        self._base_table = [
            [safe_base(self.prime_table[i][e]) for e in range(E_levels)]
            for i in range(n)
        ]

        # Precompute modular inverses for decode (inverse_cache[(b,m)] = modinv(b,m))
        self._inv_cache = {}
        for i in range(n):
            for e in range(E_levels):
                p = self.prime_table[i][e]
                b = self._base_table[i][e]
                self._inv_cache[(b, p)] = modinv(b, p)

        verify_prime_table(self.prime_table, n, E_levels, k, self.chunk_bytes)

    # ── PARAMETER GENERATION (deterministic, both sides) ───────────────

    def _quantize_entropy(self, H: float) -> int:
        """Map entropy [0, 8] → level index [0, E_levels-1]."""
        level = min(int(H / 8.0 * self.E_levels), self.E_levels - 1)
        return level

    def _lambda(self, shard_index: int, pos: int, prime: int) -> int:
        """
        Content-addressed mixing term. Deterministic from (i, pos) only.
        Prevents pattern leakage and creates position-wise differentiation.
        """
        seed = shard_index.to_bytes(2, 'big') + pos.to_bytes(4, 'big')
        return shake128_int(seed, 4) % prime

    def _params_for(self, shard_index: int, entropy_level: int):
        """Return (prime, base, inv_b) for shard i at entropy level e."""
        p = self.prime_table[shard_index][entropy_level]
        b = self._base_table[shard_index][entropy_level]
        inv_b = self._inv_cache[(b, p)]
        return p, b, inv_b

    # ── ENCODE ───────────────────────────────────────────────────────────

    def encode(self, data: bytes) -> list:
        """Encode data → n HTCShard objects. Any k recover exactly."""
        padded, pad_len = self._pad(data)
        chunks  = self._to_chunks(padded)
        n_chunks = len(chunks)

        data_hmac = hashlib.sha256(data).digest()
        residue_lists = [[] for _ in range(self.n)]

        window = CausalEntropyWindow(self.W, self.chunk_bytes)

        for pos, C in enumerate(chunks):
            H    = window.estimate()
            e_q  = self._quantize_entropy(H)

            for i in range(self.n):
                p, b, _ = self._params_for(i, e_q)
                lam      = self._lambda(i, pos, p)
                r        = (b * C + lam) % p
                residue_lists[i].append(r)

            window.push(C)

        shards = []
        for i in range(self.n):
            s = HTCShard(
                index       = i,
                residues    = residue_lists[i],
                data_len    = len(data),
                data_hmac   = data_hmac,
                shard_hmac  = b'',          # filled below
                n           = self.n,
                k           = self.k,
                W           = self.W,
                E_levels    = self.E_levels,
                chunk_bytes = self.chunk_bytes,
            )
            s.shard_hmac = s.compute_shard_hmac()
            shards.append(s)

        return shards

    # ── DECODE ───────────────────────────────────────────────────────────

    def decode(self, shards: list) -> bytes:
        """
        Reconstruct data from any k (or more) non-None, valid shards.
        Uses first valid k shards found.
        Raises ValueError if fewer than k valid shards available.
        """
        valid = self._valid_shards(shards, require_hmac=True)
        if len(valid) < self.k:
            raise ValueError(
                f"Need ≥{self.k} valid shards, have {len(valid)}"
            )
        selected = valid[:self.k]
        return self._reconstruct(selected, selected[0].data_len)

    def _reconstruct(self, selected_shards: list, data_len: int) -> bytes:
        """Core CRT reconstruction from exactly-or-more shards."""
        n_chunks = len(selected_shards[0].residues)
        window   = CausalEntropyWindow(self.W, self.chunk_bytes)
        chunks   = []

        for pos in range(n_chunks):
            H   = window.estimate()
            e_q = self._quantize_entropy(H)

            residues, moduli = [], []
            for s in selected_shards:
                i       = s.index
                p, b, inv_b = self._params_for(i, e_q)
                lam     = self._lambda(i, pos, p)
                r_i     = s.residues[pos]

                # Unwrap: c_i = (r_i - λ_i) · b_i⁻¹  mod p_i
                c_i = ((r_i - lam) * inv_b) % p
                residues.append(c_i)
                moduli.append(p)

            C = crt(residues, moduli)
            chunks.append(C)
            window.push(C)

        raw  = self._from_chunks(chunks)
        data = raw[:data_len]

        if hashlib.sha256(data).digest() != selected_shards[0].data_hmac:
            raise ValueError("Integrity check failed — data corrupted")

        return data

    # ── BYZANTINE FAULT DETECTION ────────────────────────────────────────

    def decode_byzantine(self, shards: list, max_corrupt: int = None) -> tuple:
        """
        Byzantine-tolerant reconstruction.
        Identifies corrupted shards via majority vote over C(n,k) subsets.

        Returns: (data: bytes, report: dict)
        """
        if max_corrupt is None:
            max_corrupt = (self.n - self.k) // 2

        valid = self._valid_shards(shards, require_hmac=False)
        if len(valid) < self.k:
            raise ValueError(f"Insufficient shards: {len(valid)} < {self.k}")

        # Collect candidate reconstructions
        candidate_hashes: dict = {}
        candidate_data:   dict = {}
        subset_votes:     dict = {}   # shard_index → vote count for good/bad

        for combo in combinations(valid, min(self.k, len(valid))):
            try:
                data = self._reconstruct(list(combo), combo[0].data_len)
                h    = hashlib.sha256(data).digest()
                candidate_hashes[h] = candidate_hashes.get(h, 0) + 1
                candidate_data[h]   = data
                for s in combo:
                    subset_votes[s.index] = subset_votes.get(s.index, 0) + 1
            except Exception:
                pass

        if not candidate_hashes:
            raise ValueError("No valid reconstruction found in any subset")

        # Consensus: most-voted hash
        best_hash = max(candidate_hashes, key=candidate_hashes.get)
        data      = candidate_data[best_hash]
        n_votes   = candidate_hashes[best_hash]

        # Identify which shards are consistent with the consensus
        good_shards = []
        bad_shards  = []
        for s in valid:
            try:
                d = self._reconstruct([s] + [x for x in valid
                                             if x.index != s.index][:self.k-1],
                                      s.data_len)
                if hashlib.sha256(d).digest() == best_hash:
                    good_shards.append(s.index)
                else:
                    bad_shards.append(s.index)
            except Exception:
                bad_shards.append(s.index)

        report = {
            'consensus_votes':  n_votes,
            'total_combos':     sum(candidate_hashes.values()),
            'candidates':       len(candidate_hashes),
            'good_shards':      good_shards,
            'bad_shards':       bad_shards,
            'data_verified':    hashlib.sha256(data).digest() == valid[0].data_hmac,
        }
        return data, report

    # ── DISTANCE AND CAPACITY ANALYSIS ───────────────────────────────────

    def analyse(self, data: bytes = None) -> dict:
        """
        Compute coding-theoretic properties and entropy adaptation statistics.
        If data provided, shows how adaptive geometry varies with content.
        """
        info = {
            'n':            self.n,
            'k':            self.k,
            'W':            self.W,
            'E_levels':     self.E_levels,
            'chunk_bytes':  self.chunk_bytes,
            'distance':     self.n - self.k + 1,
            'rate':         self.k / self.n,
            'overhead':     self.n / self.k,
        }

        # Prime table statistics per entropy level
        level_stats = []
        for e in range(self.E_levels):
            primes   = sorted(self.prime_table[i][e] for i in range(self.n))
            prod_k   = reduce(lambda a, b: a * b, primes[:self.k], 1)
            capacity = math.log(prod_k, 256)
            level_stats.append({
                'level':    e,
                'entropy':  round(e * 8.0 / self.E_levels, 2),
                'min_prime':primes[0],
                'max_prime':primes[-1],
                'prod_k':   prod_k,
                'capacity': round(capacity, 4),
            })
        info['level_stats'] = level_stats

        cap_min = level_stats[0]['capacity']
        cap_max = level_stats[-1]['capacity']
        info['capacity_range'] = (round(cap_min, 4), round(cap_max, 4))
        info['capacity_boost'] = round(cap_max / cap_min, 4)

        # Data-specific analysis
        if data is not None:
            shards = self.encode(data)
            window = CausalEntropyWindow(self.W, self.chunk_bytes)
            padded, _ = self._pad(data)
            chunks = self._to_chunks(padded)

            entropy_trace = []
            level_trace   = []
            for pos, C in enumerate(chunks):
                H   = window.estimate()
                e_q = self._quantize_entropy(H)
                entropy_trace.append(round(H, 3))
                level_trace.append(e_q)
                window.push(C)

            info['data_entropy_mean'] = round(
                sum(entropy_trace) / len(entropy_trace), 3)
            info['entropy_level_dist'] = dict(Counter(level_trace))
            info['entropy_variation']  = round(
                max(entropy_trace) - min(entropy_trace), 3)

        return info

    # ── HELPERS ──────────────────────────────────────────────────────────

    def _valid_shards(self, shards: list, require_hmac: bool = True) -> list:
        valid = []
        for s in shards:
            if s is None: continue
            if not isinstance(s, HTCShard): continue
            if require_hmac and not s.verify_shard_hmac(): continue
            valid.append(s)
        return valid

    def _pad(self, data: bytes) -> tuple:
        r   = len(data) % self.chunk_bytes
        pad = (self.chunk_bytes - r) % self.chunk_bytes
        return data + bytes(pad), pad

    def _to_chunks(self, data: bytes) -> list:
        cb = self.chunk_bytes
        return [int.from_bytes(data[i:i+cb], 'big')
                for i in range(0, len(data), cb)]

    def _from_chunks(self, chunks: list) -> bytes:
        return b''.join(c.to_bytes(self.chunk_bytes, 'big') for c in chunks)

